{
  "version": "2.0.0",
  "tasks": [
    { "label": "Battlecode: test", "type": "shell", "command": "uv run pytest -q", "problemMatcher": [] },
    { "label": "Battlecode: smoke", "type": "shell", "command": "uv run bctool smoke", "problemMatcher": [] },
    { "label": "Battlecode: quick", "type": "shell", "command": "uv run bctool quick", "problemMatcher": [] },
    { "label": "Battlecode: full", "type": "shell", "command": "uv run bctool full --games ${input:games}", "problemMatcher": [] }
  ],
  "inputs": [{ "id": "games", "type": "promptString", "description": "Number of games", "default": "400" }]
}